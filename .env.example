# Copy to .env.local and fill in. Never commit real secrets.
# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Robinhood Chain (env-switchable; testnet default for dev) ---
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_EXPLORER_URL=

# Mainnet (use in production):
# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Wallets ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Sessions / realtime ---
SESSION_SECRET=change-me-32-chars-min
REDIS_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WS_PORT=3001
# Dev only: allow ?guest=0x... WS connections without a session cookie. Never enable in production.
ALLOW_GUEST_WS=0

# --- WebRTC TURN (server-side only) ---
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Admin (comma-separated wallet addresses, server-side only) ---
ADMIN_WALLETS=

# --- Economy (server-authoritative; basis points, 500 = 5%) ---
PLATFORM_FEE_BPS=500

# --- Site (production: https://0xmingle.xyz) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
